---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, schema } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Yachenyi home">YACHENYI<span class="brand-dot">.</span></a>
      <nav aria-label="Primary">
        <a href="/projects/">Projects</a>
        <a href="/services/">Services</a>
        <a href="/lab/">Lab</a>
        <a href="/about/">About</a>
      </nav>
      <a class="header-contact" href="/contact/">Contact ↗</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>YACHENYI</strong>
        <p>Independent AI Software Studio</p>
      </div>
      <div class="footer-links">
        <a href="/projects/">Projects</a>
        <a href="/lab/">Lab</a>
        <a href="/facts/">Facts</a>
        <a href="/contact/">Contact</a>
      </div>
      <p class="footer-meta">One person. AI-native. Software first.</p>
    </footer>
  </body>
</html>
