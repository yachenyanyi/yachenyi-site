---
import '../styles/global.css';
import { withBase } from '../lib/site';
import { staticTranslations } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
}

const {
  title,
  description,
  noindex = false,
  schema,
  image = '/images/generated/yachenyi-brand-visual.webp',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(withBase(image), Astro.site) : withBase(image);
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logicalPath = base && path.startsWith(base) ? (path.slice(base.length) || '/') : path;
const isCurrent = (prefix: string) =>
  logicalPath === prefix || (prefix !== '/' && logicalPath.startsWith(prefix));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f4" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yachenyi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {Astro.site && <link rel="sitemap" href={withBase('/sitemap-index.xml')} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script id="static-i18n" type="application/json" set:html={JSON.stringify(staticTranslations)}></script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('motion-ready', 'i18n-pending');
        let lang = 'en';
        try {
          const saved = localStorage.getItem('yachenyi-language');
          if (saved === 'zh' || saved === 'en') lang = saved;
          else if ((navigator.language || '').toLowerCase().startsWith('zh')) lang = 'zh';
        } catch {}
        root.dataset.lang = lang;
        // Keep the initial document in English metrics. The visible language is
        // applied after the English geometry has been captured below.
        root.lang = 'en';
      })();
    </script>
  </head>
  <body>
    <div class="page-loader" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#content" data-i18n="common.skip">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="Yachenyi home">YACHENYI<span class="brand-dot">.</span></a>
      <nav aria-label="Primary" data-i18n-aria="nav.primary">
        <a href={withBase('/projects/')} aria-current={isCurrent('/projects/') ? 'page' : undefined} data-i18n="nav.projects">Projects</a>
        <a href={withBase('/services/')} aria-current={isCurrent('/services/') ? 'page' : undefined} data-i18n="nav.services">Services</a>
        <a href={withBase('/lab/')} aria-current={isCurrent('/lab/') ? 'page' : undefined} data-i18n="nav.lab">Lab</a>
        <a href={withBase('/about/')} aria-current={isCurrent('/about/') ? 'page' : undefined} data-i18n="nav.about">About</a>
      </nav>
      <div class="header-tools">
        <div class="language-switch" role="group" aria-label="Language">
          <button type="button" data-lang-option="en" aria-pressed="false">EN</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-lang-option="zh" aria-pressed="false">中文</button>
        </div>
        <a class="header-contact" href={withBase('/contact/')} aria-current={isCurrent('/contact/') ? 'page' : undefined} data-i18n="nav.contact">Contact ↗</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>YACHENYI</strong>
        <p data-i18n="footer.studio">Independent AI Software Studio</p>
      </div>
      <div class="footer-links">
        <a href={withBase('/projects/')} data-i18n="footer.projects">Projects</a>
        <a href={withBase('/lab/')} data-i18n="footer.lab">Lab</a>
        <a href={withBase('/facts/')} data-i18n="footer.facts">Facts</a>
        <a href={withBase('/contact/')} data-i18n="footer.contact">Contact</a>
      </div>
      <p class="footer-meta" data-i18n="footer.tagline">One person. AI-native. Software first.</p>
    </footer>

    <script>
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const translationsNode = document.getElementById('static-i18n');
      const translations = translationsNode ? JSON.parse(translationsNode.textContent || '{}') : {};
      const originalHtml = new WeakMap<Element, string>();
      const originalAria = new WeakMap<Element, string>();

      const translatableElements = () =>
        Array.from(document.querySelectorAll<HTMLElement>('[data-i18n]'));

      const rememberEnglish = () => {
        translatableElements().forEach((element) => {
          if (!originalHtml.has(element)) originalHtml.set(element, element.innerHTML);
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
          if (!originalAria.has(element)) originalAria.set(element, element.getAttribute('aria-label') || '');
        });
      };

      const restoreEnglishCopy = () => {
        translatableElements().forEach((element) => {
          const original = originalHtml.get(element);
          if (original !== undefined) element.innerHTML = original;
          element.style.removeProperty('font-size');
        });
      };

      const unlockLanguageGeometry = () => {
        translatableElements().forEach((element) => {
          element.classList.remove('i18n-geometry-lock', 'i18n-inline-lock');
          element.style.removeProperty('--i18n-lock-width');
          element.style.removeProperty('--i18n-lock-height');
          element.style.removeProperty('--i18n-base-font-size');
          element.style.removeProperty('font-size');
        });
      };

      const captureEnglishGeometry = () => {
        unlockLanguageGeometry();
        root.lang = 'en';
        restoreEnglishCopy();

        // Force one English layout pass before recording dimensions.
        void document.body.offsetWidth;

        translatableElements().forEach((element) => {
          const rect = element.getBoundingClientRect();
          if (rect.width <= 0 || rect.height <= 0) return;

          const style = getComputedStyle(element);
          element.style.setProperty('--i18n-lock-width', `${rect.width}px`);
          element.style.setProperty('--i18n-lock-height', `${rect.height}px`);
          element.style.setProperty('--i18n-base-font-size', style.fontSize);
          element.classList.add('i18n-geometry-lock');

          if (style.display === 'inline') {
            element.classList.add('i18n-inline-lock');
          }
        });
      };

      const fitTranslatedCopy = () => {
        translatableElements().forEach((element) => {
          const baseSize = Number.parseFloat(element.style.getPropertyValue('--i18n-base-font-size'));
          if (!Number.isFinite(baseSize) || baseSize <= 0) return;

          element.style.removeProperty('font-size');
          let size = baseSize;
          const minimum = baseSize * 0.82;

          while (
            size > minimum &&
            (element.scrollHeight > element.clientHeight + 1 || element.scrollWidth > element.clientWidth + 1)
          ) {
            size -= 0.5;
            element.style.fontSize = `${size}px`;
          }
        });
      };

      const applyLanguage = (lang: string, persist = true) => {
        const normalized = lang === 'zh' ? 'zh' : 'en';
        root.dataset.lang = normalized;
        root.lang = normalized === 'zh' ? 'zh-CN' : 'en';

        translatableElements().forEach((element) => {
          const key = element.getAttribute('data-i18n');
          const translated = key && translations?.zh?.[key];
          const original = originalHtml.get(element);
          element.innerHTML = normalized === 'zh' && translated ? translated : (original ?? element.innerHTML);
          element.style.removeProperty('font-size');
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
          const key = element.getAttribute('data-i18n-aria');
          const translated = key && translations?.zh?.[key];
          const original = originalAria.get(element) ?? '';
          element.setAttribute('aria-label', normalized === 'zh' && translated ? translated : original);
        });

        if (normalized === 'zh') fitTranslatedCopy();

        document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
          const active = button.getAttribute('data-lang-option') === normalized;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });

        if (persist) {
          try { localStorage.setItem('yachenyi-language', normalized); } catch {}
        }
      };

      rememberEnglish();
      captureEnglishGeometry();
      applyLanguage(root.dataset.lang || 'en', false);
      root.classList.remove('i18n-pending');

      document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
        button.addEventListener('click', () => applyLanguage(button.getAttribute('data-lang-option') || 'en'));
      });

      let languageResizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(languageResizeTimer);
        languageResizeTimer = window.setTimeout(() => {
          const currentLanguage = root.dataset.lang || 'en';
          root.classList.add('i18n-reflowing');
          captureEnglishGeometry();
          applyLanguage(currentLanguage, false);
          root.classList.remove('i18n-reflowing');
        }, 160);
      });

      const revealImages = () => {
        document.querySelectorAll('img').forEach((image) => {
          const reveal = () => image.classList.add('image-ready');
          if (image.complete) reveal();
          else {
            image.addEventListener('load', reveal, { once: true });
            image.addEventListener('error', reveal, { once: true });
          }
        });
      };

      const revealSections = () => {
        const targets = document.querySelectorAll(
          '.section, .about-grid, .contact-grid, .article-shell, .prose, .site-footer'
        );

        if (reduceMotion || !('IntersectionObserver' in window)) {
          targets.forEach((target) => target.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -7% 0px' }
        );

        targets.forEach((target) => observer.observe(target));
      };

      revealImages();
      revealSections();

      requestAnimationFrame(() => {
        requestAnimationFrame(() => root.classList.add('page-ready'));
      });

      const complete = () => root.classList.add('page-complete');
      if (document.readyState === 'complete') complete();
      else window.addEventListener('load', complete, { once: true });
    </script>
  </body>
</html>
