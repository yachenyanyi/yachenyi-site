---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('lab'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const images = [
  '/images/generated/home-misty-mountains.webp',
  '/images/generated/misty-blue-coast.webp',
  '/images/generated/futurist-white-architecture.webp',
];
---

<BaseLayout
  title="Lab — Yachenyi"
  description="Build notes, architecture decisions and experiments from Yachenyi."
>
  <section class="page-intro">
    <div class="eyebrow">Lab / Build Log</div>
    <h1 class="page-title">Notes from<br />the workbench.</h1>
    <p class="lead">Architecture decisions, experiments and lessons collected while building AI-native software and automation systems.</p>
  </section>

  <section class="section">
    <div class="lab-grid">
      {posts.map((post, index) => (
        <a class="lab-card" href={`/lab/${post.id}/`}>
          <img src={images[index % images.length]} alt="" loading="lazy" />
          <div class="lab-card-body">
            <div class="meta">{post.data.publishedAt.toISOString().slice(0, 10)} · {post.data.tags.slice(0, 2).join(' / ')}</div>
            <h2>{post.data.title}</h2>
            <p>{post.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
