---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const title = project.data.seo?.title ?? `${project.data.title} — Yachenyi`;
const description = project.data.seo?.description ?? project.data.summary;

const images: Record<string, string> = {
  'deep-loopminder': '/images/generated/ai-network-workbench.webp',
  issuepack: '/images/generated/home-creative-workspace.webp',
  autoscreenagent: '/images/generated/futurist-white-architecture.webp',
};
const image = images[project.id] ?? '/images/generated/home-misty-mountains.webp';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.data.title,
  description,
  creator: { '@type': 'Person', name: 'Yachenyi' },
  codeRepository: project.data.github,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined,
};
---

<BaseLayout title={title} description={description} noindex={project.data.seo?.noindex} schema={schema} image={image}>
  <section class="article-hero">
    <div>
      <div class="eyebrow"><span data-i18n="project.label">Project</span> / {project.data.status}</div>
      <h1 class="article-title">{project.data.title}</h1>
      <p class="lead article-summary">{project.data.summary}</p>
      {project.data.github && (
        <div class="hero-actions">
          <a class="button button-dark" href={project.data.github} data-i18n="project.source">View source ↗</a>
          <a class="text-link" href={withBase('/projects/')} data-i18n="project.all">All projects →</a>
        </div>
      )}
    </div>
    <img class="article-hero-media" src={withBase(image)} alt="" loading="eager" />
  </section>

  <section class="article-shell">
    <aside class="article-aside">
      <dl>
        <div><dt data-i18n="project.status">Status</dt><dd>{project.data.status}</dd></div>
        <div><dt data-i18n="project.updated">Updated</dt><dd>{project.data.updatedAt.toISOString().slice(0, 10)}</dd></div>
        <div><dt data-i18n="project.builtby">Built by</dt><dd>Yachenyi</dd></div>
      </dl>
    </aside>
    <article class="article-body">
      <Content />
    </article>
  </section>
</BaseLayout>
