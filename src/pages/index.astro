---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';

const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf())
  .slice(0, 3);

const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const labPosts = (await getCollection('lab'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const serviceIcons: Record<string, string> = {
  'ai-agents': '/icons/services/ai-agents.webp',
  automation: '/icons/services/automation.webp',
  'web-systems': '/icons/services/web-systems.webp',
};

const projectImages: Record<string, string> = {
  'deep-loopminder': '/images/generated/ai-network-workbench.webp',
  issuepack: '/images/generated/home-creative-workspace.webp',
  autoscreenagent: '/images/generated/futurist-white-architecture.webp',
};

const labImages = [
  '/images/generated/home-misty-mountains.webp',
  '/images/generated/misty-blue-coast.webp',
];

const studioSnapshot = [
  { label: 'Mode', value: 'Independent' },
  { label: 'Focus', value: 'AI-native systems' },
  { label: 'Method', value: 'Smallest reliable system' },
  { label: 'Output', value: 'Software + build notes' },
];

const process = [
  {
    number: '01',
    title: 'Frame the real problem',
    copy: 'Start from the repeated friction, the existing workflow and the evidence that software should exist at all.',
  },
  {
    number: '02',
    title: 'Prototype the smallest system',
    copy: 'Prove the workflow with the fewest moving parts before adding orchestration, persistence or model complexity.',
  },
  {
    number: '03',
    title: 'Make state explicit',
    copy: 'Keep context, decisions and progress observable so long-running software can be resumed, inspected and trusted.',
  },
  {
    number: '04',
    title: 'Harden what survives',
    copy: 'Turn the useful prototype into maintainable software with clear boundaries, tests, documentation and automation.',
  },
];

const focusAreas = [
  {
    title: 'Agent coordination',
    copy: 'Long-running agent workflows, delegation and durable execution without losing project state.',
  },
  {
    title: 'Context infrastructure',
    copy: 'Reusable issue packages, structured evidence and compact context that survives across tools and sessions.',
  },
  {
    title: 'Operational automation',
    copy: 'Replacing repetitive software work with observable systems that remain understandable to a human operator.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Yachenyi',
    url: Astro.site?.toString(),
    jobTitle: 'Independent AI Software Builder',
    knowsAbout: ['AI Agents', 'Automation', 'Developer Tools', 'Software Engineering'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Yachenyi',
    url: Astro.site?.toString(),
  },
];
---

<BaseLayout
  title="Yachenyi — Independent AI Software Studio"
  description="Yachenyi builds AI agents, automation systems, developer tools and AI-native software."
  schema={schema}
  image="/images/generated/home-creative-workspace.webp"
>
  <section class="hero hero-editorial">
    <div class="hero-copy">
      <div class="eyebrow">Independent AI Software Studio</div>
      <h1>Ideas into<br />useful software.</h1>
      <p class="lead">
        AI agents, automation, developer tools and focused software systems — designed, built and documented by one independent builder.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href={withBase('/projects/')}>View projects</a>
        <a class="text-link" href={withBase('/lab/')}>Read the lab <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <figure class="hero-visual">
      <img
        src={withBase('/images/generated/home-creative-workspace.webp')}
        alt="A quiet minimal workspace representing the Yachenyi independent software studio"
        width="1600"
        height="1000"
        loading="eager"
      />
      <figcaption>Independent, AI-native, deliberately small.</figcaption>
    </figure>
  </section>

  <section class="studio-snapshot" aria-label="Studio snapshot">
    {studioSnapshot.map((item) => (
      <div class="snapshot-item">
        <span>{item.label}</span>
        <strong>{item.value}</strong>
      </div>
    ))}
  </section>

  <section class="section split-feature">
    <div>
      <div class="eyebrow">Currently building</div>
      <h2 class="display-2">Software that coordinates software work.</h2>
      <p class="section-copy">
        Current experiments focus on long-running agent workflows, durable project state and practical automation that turns repetitive development work into reusable systems.
      </p>
      <a class="text-link" href={withBase('/projects/deep-loopminder/')}>Explore DeepLoopMinder <span aria-hidden="true">↗</span></a>
    </div>
    <img
      class="feature-image"
      src={withBase('/images/generated/ai-network-workbench.webp')}
      alt="Minimal workstation with a connected AI network visualization"
      width="1400"
      height="900"
      loading="lazy"
    />
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Selected work</div>
        <h2 class="display-2">Projects</h2>
      </div>
      <a class="text-link" href={withBase('/projects/')}>All projects <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-grid">
      {projects.map((project, index) => (
        <a class:list={['project-card', { 'project-card-wide': index === 0 }]} href={withBase(`/projects/${project.id}/`)}>
          <div class="project-card-media">
            <img src={withBase(projectImages[project.id] ?? '/images/generated/home-misty-mountains.webp')} alt="" loading="lazy" />
          </div>
          <div class="project-card-body">
            <div class="meta">{project.data.status}</div>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section process-section">
    <div class="process-intro">
      <div class="eyebrow">How I work</div>
      <h2 class="display-2">From repeated friction to a system.</h2>
      <p class="section-copy">
        The goal is not to add AI everywhere. It is to identify where software can remove repeated effort, then make that software explicit, observable and maintainable.
      </p>
    </div>

    <div class="process-list">
      {process.map((step) => (
        <article class="process-step">
          <span class="process-number">{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">What I build</div>
        <h2 class="display-2">Services</h2>
      </div>
      <a class="text-link" href={withBase('/services/')}>Details <span aria-hidden="true">→</span></a>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={withBase(`/services/${service.id}/`)}>
          <img class="service-icon" src={withBase(serviceIcons[service.id])} alt="" width="128" height="128" loading="lazy" />
          <div>
            <h3>{service.data.title}</h3>
            <p>{service.data.summary}</p>
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section focus-section">
    <div class="focus-panel">
      <div class="focus-heading">
        <div>
          <div class="eyebrow">Current focus</div>
          <h2 class="display-2">Building the infrastructure around AI work.</h2>
        </div>
        <p>
          Most current experiments sit one layer below the chatbot interface: orchestration, context, durable state and the operational tooling that makes model-driven work dependable.
        </p>
      </div>

      <div class="focus-grid">
        {focusAreas.map((area, index) => (
          <article class="focus-item">
            <span>0{index + 1}</span>
            <h3>{area.title}</h3>
            <p>{area.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Notes from the lab</div>
        <h2 class="display-2">Build in public.</h2>
      </div>
      <a class="text-link" href={withBase('/lab/')}>Open Lab <span aria-hidden="true">→</span></a>
    </div>

    <div class="lab-grid">
      {labPosts.map((post, index) => (
        <a class="lab-card" href={withBase(`/lab/${post.id}/`)}>
          <img src={withBase(labImages[index % labImages.length])} alt="" loading="lazy" />
          <div class="lab-card-body">
            <div class="meta">{post.data.publishedAt.toISOString().slice(0, 10)}</div>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section contact-panel">
    <div>
      <div class="eyebrow">Have a project in mind?</div>
      <h2 class="display-2">Build something useful.</h2>
    </div>
    <a class="button button-dark" href={withBase('/contact/')}>Start a conversation</a>
  </section>
</BaseLayout>
