---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartographicArt from '../components/CartographicArt.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => b.data.updatedAt.valueOf()-a.data.updatedAt.valueOf());
const posts = (await getCollection('lab')).filter(p => !p.data.draft).slice(0,2);
const labels = ['AGENT SYSTEMS','CONTEXT TOOLS','SCREEN AUTOMATION'];
---
<BaseLayout title="Yachenyi — Independent AI Software Studio" description="Independent software, thoughtful automation, and AI systems. Built by Yachenyi.">
  <section class="studio-hero" aria-labelledby="home-title">
    <div class="studio-hero__top"><span class="eyebrow">YACHENYI / INDEPENDENT SOFTWARE STUDIO</span><span class="eyebrow">IDEAS → WORKING SYSTEMS</span></div>
    <CartographicArt />
    <h1 id="home-title"><span data-i18n="new.hero.one">Less friction.</span><br/><span class="studio-hero__accent" data-i18n="new.hero.two">More possibility.</span><span class="hero-asterisk" aria-hidden="true">✳</span></h1>
    <div class="studio-hero__bottom"><p data-i18n="new.hero.copy">I build thoughtful software that turns complex work into something beautifully simple.</p><a class="button button-accent" href="#work"><span data-i18n="new.hero.action">Step inside the work</span><span aria-hidden="true">↘</span></a><span class="hero-scroll eyebrow">SCROLL TO TRANSFORM ↓</span></div>
  </section>
  <section class="window-story" id="work" aria-label="Selected projects">
    <div class="window-sticky">
      <div class="window-caption"><span class="eyebrow">01 / SELECTED WORK</span><span class="eyebrow" data-i18n="new.window.hint">One window. Different possibilities.</span><button type="button" class="motion-toggle" aria-pressed="false" data-i18n="new.motion">Pause motion</button></div>
      <div class="work-window">
        <div class="window-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>yachenyi / workspace</span><span aria-hidden="true">↗</span></div>
        <div class="window-scenes">
          {projects.map((project,i) => <article class:list={['window-scene',{'is-active':i===0}]} data-scene={i}>
            <div class="window-copy"><span class="eyebrow">0{i+1} / {labels[i] ?? 'SOFTWARE'}</span><h2>{project.data.title}</h2><p>{project.data.summary}</p><a class="text-link" href={withBase(`/projects/${project.id}/`)}><span data-i18n="new.project">Explore the project</span> ↗</a><span class="window-status">● {project.data.status}</span></div>
            <div class:list={['system-art',`system-art--${i}`]} aria-hidden="true">
              <div class="art-grid"></div><CartographicArt variant="window" /><div class="art-orbit"></div>
              <svg class="art-connections" viewBox="0 0 600 470" preserveAspectRatio="none" aria-hidden="true"><path d="M130 155H210L350 245H425M350 245L220 355H155" fill="none"/><circle cx="210" cy="155" r="4"/><circle cx="220" cy="355" r="4"/></svg>
              <span class="art-label">{i===0?'ORCHESTRATE':i===1?'MAKE SENSE':'TAKE ACTION'}</span>
              <div class="art-node art-node--a">{i===0?'GOAL':i===1?'CONVERSATION':'OBSERVE'}<span>↘</span></div>
              <div class="art-node art-node--b">{i===0?'AGENT':i===1?'CONTEXT':'REASON'}<span>✳</span></div>
              <div class="art-node art-node--c">{i===0?'BUILD':i===1?'ISSUE PACK':'ACT'}<span>↗</span></div>
              <div class="art-coordinate">FIG. 0{i+1} — SYSTEM CONCEPT</div>
            </div>
          </article>)}
        </div>
        <div class="window-tabs" role="group" aria-label="Select project">{projects.map((p,i)=><button type="button" data-scene-tab={i} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{p.data.title}<span class="tab-progress"></span></button>)}</div>
      </div>
    </div>
  </section>
  <section class="studio-manifesto" data-reveal><span class="eyebrow">02 / THE APPROACH</span><h2 data-i18n="new.manifesto">Small by design.<br/>Ambitious by nature.</h2><div class="manifesto-bottom"><span class="manifesto-symbol" aria-hidden="true">↗</span><p data-i18n="new.manifesto.copy">One independent builder. A clear line from the first question to the final product. Less noise, more care, and systems that make sense.</p><a class="text-link" href={withBase('/about/')}><span data-i18n="nav.studio">About the studio</span> ↗</a></div></section>
  <section class="studio-journal" data-reveal><div class="section-heading"><div><span class="eyebrow">03 / FIELD NOTES</span><h2 class="section-title" data-i18n="new.notes">Thinking out loud.</h2></div><a class="section-link" href={withBase('/lab/')}><span data-i18n="home.saas.notes.link">Read the lab</span> ↗</a></div>{posts.map((p,i)=><a class="journal-row" href={withBase(`/lab/${p.id}/`)}><span class="eyebrow">0{i+1} / {p.data.publishedAt.toISOString().slice(0,10)}</span><h3>{p.data.title}</h3><span aria-hidden="true">↗</span></a>)}</section>
  <section class="studio-cta" data-reveal><span class="eyebrow">NEXT / YOUR IDEA</span><h2 data-i18n="new.cta">Let's make<br/>something matter.</h2><a class="button button-dark" href={withBase('/contact/')}><span data-i18n="home.saas.cta.action">Start a conversation</span> ↗</a><span class="cta-star" aria-hidden="true">✳</span></section>
</BaseLayout>
<script>
import { setupStudioMotion } from '../lib/studio-motion';
setupStudioMotion();
</script>
