---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';

const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf())
  .slice(0, 3);
const labPosts = (await getCollection('lab'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const projectImages: Record<string, string> = {
  'deep-loopminder': '/images/generated/ai-network-workbench.webp',
  issuepack: '/images/generated/home-creative-workspace.webp',
  autoscreenagent: '/images/generated/futurist-white-architecture.webp',
};
const labImages: Record<string, string> = {
  'durable-project-state': '/images/generated/home-misty-mountains.webp',
  'static-first-opc-site': '/images/generated/misty-blue-coast.webp',
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Yachenyi', url: Astro.site?.toString(), jobTitle: 'Independent AI Software Builder', knowsAbout: ['AI Agents', 'Automation', 'Developer Tools', 'Software Engineering'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Yachenyi', url: Astro.site?.toString() },
];
---

<BaseLayout
  title="Yachenyi — Independent AI Software Studio"
  description="Yachenyi builds reliable AI agent systems, workflow automation, developer tools and focused web software."
  schema={schema}
  image="/images/generated/ai-network-workbench.webp"
>
  <div class="landing-stage">
  <section
    class="immersive-hero"
    aria-labelledby="home-title"
  >
    <div class="immersive-hero__content">
      <h1 id="home-title" class="immersive-title" data-i18n="home.saas.title">
        I build tools for complex workflows.
      </h1>
      <p class="immersive-lead" data-reveal data-i18n="home.saas.lead">
        From agent orchestration to everyday automation, I turn complex workflows into focused, reliable software — built to be understood, improved, and used.
      </p>
      <div class="hero-actions" data-reveal>
        <a href={withBase('/projects/')} class="button button-accent">
          <span data-i18n="home.saas.action.projects">Explore projects</span>
        </a>
        <a href={withBase('/contact/')} class="button button-glass">
          <span data-i18n="home.saas.action.contact">Let's build together</span>
        </a>
      </div>
    </div>
    <div class="hero-artwork glass-title-stage" aria-hidden="true">
      <svg class="hero-artwork__diagram" viewBox="0 0 560 440" fill="none">
        <defs>
          <radialGradient id="orbit-light">
            <stop stop-color="#7189ec" stop-opacity=".42" />
            <stop offset="1" stop-color="#26345e" stop-opacity="0" />
          </radialGradient>
        </defs>
        <ellipse cx="280" cy="220" rx="255" ry="210" fill="url(#orbit-light)" />
        <g stroke="#a9baff" stroke-opacity=".32">
          <circle cx="280" cy="220" r="163" />
          <circle cx="280" cy="220" r="188" stroke-dasharray="1 7" />
          <ellipse cx="280" cy="220" rx="230" ry="102" transform="rotate(-28 280 220)" />
          <ellipse cx="280" cy="220" rx="230" ry="102" transform="rotate(28 280 220)" />
        </g>
        <g fill="#ffd9a0">
          <circle cx="114" cy="271" r="4" />
          <circle cx="431" cy="156" r="5" />
        </g>
        <circle cx="378" cy="357" r="3" fill="#b9c3df" />
      </svg>
      <canvas class="glass-title-canvas"></canvas>
    </div>
  </section>

  <section class="home-section project-strip" id="selected-work" aria-labelledby="work-title">
    <div class="section-heading section-heading--glass" data-reveal>
      <div>
        <h2 id="work-title" class="section-title" data-i18n="home.saas.work.label">Selected projects</h2>
      </div>
      <a class="section-link" href={withBase('/projects/')}>
        <span data-i18n="home.saas.work.link">All projects</span><span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-carousel" data-reveal>
    <div class="home-project-grid">
      {projects.map((project, index) => (
        <a
          class:list={['home-project-card', { 'home-project-card--featured': index === 0 }]}
          href={withBase(`/projects/${project.id}/`)}
          data-liquid-scene
        >
          <div class="home-project-card__image">
            <img
              src={withBase(projectImages[project.id] ?? '/images/generated/ai-network-workbench.webp')}
              alt=""
              loading="lazy"
              width="1200"
              height="750"
              data-liquid-source
            />
            <span class="project-status">{project.data.status}</span>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </div>
          <LiquidGlass class="home-project-card__body" variant="strip" image={withBase(projectImages[project.id] ?? '/images/generated/ai-network-workbench.webp')}>
            <h3>{project.data.title}</h3>
          </LiquidGlass>
        </a>
      ))}
    </div>
    </div>
    <div class="project-carousel-controls">
      <p class="project-interaction-hint" data-i18n="home.carousel.hint">Drag to explore · Scroll to turn</p>
      <button class="project-rotation-toggle" type="button" data-project-rotation hidden aria-label="Pause project rotation" aria-pressed="false">Ⅱ</button>
    </div>
  </section>

  </div>

  <section id="studio-notes" class="home-section home-notes" aria-labelledby="notes-title">
    <div class="section-heading section-heading--glass" data-reveal>
      <div>
        <span class="section-eyebrow"><span class="section-eyebrow__dot" aria-hidden="true"></span><span data-i18n="home.saas.notes.label">From the lab</span></span>
        <h2 id="notes-title" class="section-title" data-i18n="home.saas.notes.title">Notes from the workbench.</h2>
      </div>
      <a class="section-link" href={withBase('/lab/')}>
        <span data-i18n="home.saas.notes.link">Read the lab</span><span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="home-notes-grid">
      {labPosts.map((post, index) => (
        <a
          class="home-note-card glass-panel"
          href={withBase(`/lab/${post.id}/`)}
          data-liquid-scene
          data-reveal
          style={`--reveal-delay: ${index * 100}ms`}
        >
          <img
            src={withBase(labImages[post.id] ?? '/images/generated/misty-blue-coast.webp')}
            alt=""
            loading="lazy"
            width="1000"
            height="620"
            data-liquid-source
          />
          <LiquidGlass class="home-note-card__body" variant="strip" image={withBase(labImages[post.id] ?? '/images/generated/misty-blue-coast.webp')}>
            <div class="note-meta"><span>{post.data.publishedAt.toISOString().slice(0, 10)}</span><span>{post.data.tags.slice(0, 2).join(' / ')}</span></div>
            <h3>{post.data.title}</h3>
            <span class="note-open" aria-hidden="true">↗</span>
          </LiquidGlass>
        </a>
      ))}
    </div>
  </section>

  <LiquidGlass as="section" class="home-contact" data-reveal aria-labelledby="contact-title">
    <span class="section-eyebrow"><span class="section-eyebrow__dot" aria-hidden="true"></span><span data-i18n="home.saas.cta.label">Let's collaborate</span></span>
    <h2 id="contact-title" data-i18n="home.saas.cta.title">Have a problem worth solving?<br /><span class="saas-gradient-text">Let's build something useful.</span></h2>
    <p data-i18n="home.saas.cta.copy">A focused project starts with a good question. Tell me what isn't working, and we'll find the smallest reliable way forward.</p>
    <a href={withBase('/contact/')} class="button button-accent">
      <span data-i18n="home.saas.cta.action">Start a conversation</span><span aria-hidden="true">↗</span>
    </a>
  </LiquidGlass>
</BaseLayout>

<script>
  import { setupHomeMotion } from '../lib/home-motion';
  import { setupProjectCarousel } from '../lib/project-carousel';
  import { setupSmoothScroll } from '../lib/smooth-scroll';

  import { setupGlassHero } from '../lib/glass-hero';

  setupGlassHero();
  setupSmoothScroll();
  setupProjectCarousel();
  setupHomeMotion();

</script>
