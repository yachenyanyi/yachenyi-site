---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartographicArt from '../components/CartographicArt.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());

const posts = (await getCollection('lab'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const labels: Record<string, string> = {
  'deep-loopminder': '01 / AGENT SYSTEMS',
  issuepack: '02 / CONTEXT TOOLS',
  autoscreenagent: '03 / SCREEN AUTOMATION',
};

const domains: Record<string, string> = {
  'deep-loopminder': 'Multi-agent · Durable state',
  issuepack: 'Local-first · Context packs',
  autoscreenagent: 'Accessibility API · Tool calls',
};

const principles = [
  {
    num: '01',
    code: 'UTILITY FIRST',
    titleKey: 'new.p1.title',
    title: 'Useful before impressive.',
    copyKey: 'new.p1.copy',
    copy: 'Start from repeated operational friction and remove it with the smallest verifiable software.',
  },
  {
    num: '02',
    code: 'EXPLICIT STATE',
    titleKey: 'new.p2.title',
    title: 'Explicit state over hidden magic.',
    copyKey: 'new.p2.copy',
    copy: 'Keep tasks, context, and artifacts inspectable so long-running workflows stay recoverable.',
  },
  {
    num: '03',
    code: 'DURABLE SCOPE',
    titleKey: 'new.p3.title',
    title: 'Restrained architecture that lasts.',
    copyKey: 'new.p3.copy',
    copy: 'Stay static and simple when possible; add runtime complexity only where the problem demands it.',
  },
];
---
<BaseLayout title="Yachenyi — Independent AI Software Studio" description="Independent software, thoughtful automation, and AI systems. Built by Yachenyi.">
  <section class="studio-hero" aria-labelledby="home-title">
    <div class="studio-hero__top">
      <span class="eyebrow" data-i18n="new.hero.tag">YACHENYI / INDEPENDENT SOFTWARE STUDIO</span>
      <span class="eyebrow" data-i18n="new.hero.flow">IDEAS → WORKING SYSTEMS</span>
    </div>
    <div class="studio-hero__grid">
      <div class="studio-hero__main">
        <h1 id="home-title">
          <span data-i18n="new.hero.one">Less friction.</span><br />
          <span class="studio-hero__accent" data-i18n="new.hero.two">More possibility.</span>
        </h1>
        <div class="studio-hero__bottom">
          <p data-i18n="new.hero.copy">I build thoughtful software that turns complex work into something beautifully simple.</p>
          <div class="studio-hero__actions">
            <a class="button button-accent" href="#work">
              <span data-i18n="new.hero.action">Step inside the work</span><span aria-hidden="true">↘</span>
            </a>
            <a class="text-link" href={withBase('/projects/')}>
              <span data-i18n="new.hero.projects">All projects</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <div class="studio-hero__stage">
        <div class="studio-hero__frame">
          <span class="hero-asterisk" aria-hidden="true">✳</span>
          <CartographicArt />
        </div>
        <div class="studio-hero__bar">
          <span class="studio-hero__badge" data-i18n="new.hero.badge">Y / 01 — INDEPENDENT BY DESIGN</span>
          <span class="hero-scroll eyebrow" data-i18n="new.hero.scroll">SCROLL TO TRANSFORM ↓</span>
        </div>
      </div>
    </div>
  </section>

  <section class="window-story" id="work" aria-label="Selected projects">
    <div class="window-sticky">
      <div class="window-caption">
        <span class="eyebrow" data-i18n="new.window.section">01 / SELECTED WORK</span>
        <span class="eyebrow" data-i18n="new.window.hint">One window. Three working systems.</span>
        <button type="button" class="motion-toggle" aria-pressed="false" data-i18n="new.motion">Pause motion</button>
      </div>
      <div class="work-window">
        <div class="window-toolbar">
          <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>yachenyi / workspace — [01—03]</span>
          <span aria-hidden="true">↗</span>
        </div>
        <div class="window-scenes">
          {projects.map((project, i) => (
            <article class:list={['window-scene', { 'is-active': i === 0 }]} data-scene={i}>
              <div class="window-copy">
                <div class="window-copy__head">
                  <span class="eyebrow" data-i18n={`new.work.${project.id}.label`}>{labels[project.id] ?? `0${i + 1} / SOFTWARE`}</span>
                  <span class="window-code">SYS—0{i + 1}</span>
                </div>
                <h2>{project.data.title}</h2>
                <p data-i18n={`new.work.${project.id}.summary`}>{project.data.summary}</p>
                <a class="text-link" href={withBase(`/projects/${project.id}/`)}>
                  <span data-i18n="new.project">Explore the project</span> <span aria-hidden="true">↗</span>
                </a>
                <dl class="window-specs">
                  <div>
                    <dt data-i18n="new.spec.status">Status</dt>
                    <dd><span class="spec-dot" aria-hidden="true"></span>{project.data.status}</dd>
                  </div>
                  <div>
                    <dt data-i18n="new.spec.updated">Updated</dt>
                    <dd>{project.data.updatedAt.toISOString().slice(0, 10)}</dd>
                  </div>
                  <div>
                    <dt data-i18n="new.spec.domain">Core</dt>
                    <dd data-i18n={`new.work.${project.id}.domain`}>{domains[project.id] ?? 'AI Software'}</dd>
                  </div>
                </dl>
              </div>
              <div class:list={['system-art', `system-art--${i}`]} aria-hidden="true">
                <div class="art-grid"></div>
                <CartographicArt variant="window" />
                <div class="art-orbit"></div>
                <svg class="art-connections" viewBox="0 0 600 470" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M130 155H210L350 245H425M350 245L220 355H155" fill="none" />
                  <circle cx="210" cy="155" r="4" />
                  <circle cx="220" cy="355" r="4" />
                </svg>
                <span class="art-label">{i === 0 ? 'ORCHESTRATE' : i === 1 ? 'MAKE SENSE' : 'TAKE ACTION'}</span>
                <div class="art-node art-node--a">{i === 0 ? 'GOAL' : i === 1 ? 'CONVERSATION' : 'OBSERVE'}<span>↘</span></div>
                <div class="art-node art-node--b">{i === 0 ? 'AGENT' : i === 1 ? 'CONTEXT' : 'REASON'}<span>✳</span></div>
                <div class="art-node art-node--c">{i === 0 ? 'BUILD' : i === 1 ? 'ISSUE PACK' : 'ACT'}<span>↗</span></div>
                <div class="art-coordinate">FIG. 0{i + 1} — SYSTEM CONCEPT</div>
              </div>
            </article>
          ))}
        </div>
        <div class="window-tabs" role="group" aria-label="Select project">
          {projects.map((p, i) => (
            <button type="button" data-scene-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span>0{i + 1}</span>{p.data.title}<span class="tab-progress"></span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="studio-manifesto" data-reveal>
    <div class="manifesto-grid">
      <div class="manifesto-lead">
        <span class="eyebrow" data-i18n="new.approach.eyebrow">02 / THE APPROACH</span>
        <h2 data-i18n="new.manifesto">Small by design.<br />Ambitious by nature.</h2>
        <p data-i18n="new.manifesto.copy">One independent builder. A clear line from the first question to the final product. Less noise, more care, and systems that make sense.</p>
        <div class="manifesto-lead__foot">
          <a class="text-link" href={withBase('/about/')}>
            <span data-i18n="nav.studio">About the studio</span> <span aria-hidden="true">↗</span>
          </a>
          <span class="manifesto-coord" aria-hidden="true">AXIS / 02 — DIRECT ENGINEERING</span>
        </div>
      </div>
      <div class="manifesto-cards">
        {principles.map((item) => (
          <article class="manifesto-card">
            <span class="manifesto-card__tag">{item.code}</span>
            <span class="manifesto-card__hex" aria-hidden="true">{item.num}</span>
            <div class="manifesto-card__body">
              <h3 data-i18n={item.titleKey}>{item.title}</h3>
              <p data-i18n={item.copyKey}>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="studio-journal" data-reveal>
    <div class="section-heading">
      <div>
        <span class="eyebrow" data-i18n="new.notes.eyebrow">03 / FIELD NOTES</span>
        <h2 class="section-title" data-i18n="new.notes">Thinking out loud.</h2>
      </div>
      <a class="section-link" href={withBase('/lab/')}>
        <span data-i18n="home.saas.notes.link">Read the lab</span> <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="journal-grid">
      {posts.map((p, i) => (
        <a class="journal-card" href={withBase(`/lab/${p.id}/`)}>
          <div class="journal-card__top">
            <span class="journal-card__badge">LOG / 0{i + 1}</span>
            <span class="eyebrow">{p.data.publishedAt.toISOString().slice(0, 10)}</span>
          </div>
          <h3 data-i18n={`new.lab.${p.id}.title`}>{p.data.title}</h3>
          <p data-i18n={`new.lab.${p.id}.summary`}>{p.data.summary}</p>
          <div class="journal-card__bottom">
            <div class="journal-tags">
              {p.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
            <span class="journal-card__open">
              <span data-i18n="new.notes.read">Read note</span> <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="studio-cta" data-reveal>
    <div class="cta-panel">
      <div class="cta-panel__bar">
        <span class="cta-panel__badge" data-i18n="new.cta.eyebrow">NEXT / YOUR IDEA</span>
        <span class="eyebrow" data-i18n="new.cta.status">STATUS: OPEN FOR FOCUSED WORK</span>
      </div>
      <div class="cta-panel__grid">
        <div class="cta-panel__main">
          <h2 data-i18n="new.cta">Let's make<br />something matter.</h2>
          <p data-i18n="new.cta.copy">A good project starts with a concrete question. Tell me where the workflow hurts, and we'll build the smallest reliable system to fix it.</p>
          <div class="cta-panel__actions">
            <a class="button button-dark" href={withBase('/contact/')}>
              <span data-i18n="home.saas.cta.action">Start a conversation</span> <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="cta-panel__channels">
          <a class="cta-channel" href={withBase('/contact/')}>
            <span class="cta-channel__hex" aria-hidden="true">01</span>
            <div>
              <strong data-i18n="footer.contact">Contact</strong>
              <small data-i18n="new.cta.brief">Project scope & collaboration brief</small>
            </div>
            <span aria-hidden="true">→</span>
          </a>
          <a class="cta-channel" href="https://github.com/yachenyanyi" rel="me" target="_blank">
            <span class="cta-channel__hex" aria-hidden="true">02</span>
            <div>
              <strong>GitHub</strong>
              <small data-i18n="new.cta.github">Open-source repositories & active builds</small>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
          <a class="cta-channel" href={withBase('/projects/')}>
            <span class="cta-channel__hex" aria-hidden="true">03</span>
            <div>
              <strong data-i18n="nav.projects">Projects</strong>
              <small data-i18n="new.cta.archive">Inspect all published software systems</small>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <span class="cta-star" aria-hidden="true">✳</span>
    </div>
  </section>
</BaseLayout>
<script>
  import { setupStudioMotion } from '../lib/studio-motion';
  setupStudioMotion();
</script>
