---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const serviceIcons: Record<string, string> = {
  'ai-agents': '/icons/services/ai-agents.webp',
  automation: '/icons/services/automation.webp',
  'web-systems': '/icons/services/web-systems.webp',
};
---

<BaseLayout
  title="Services — Yachenyi"
  description="AI agents, automation, internal tools and web systems from Yachenyi."
>
  <section class="page-intro">
    <div class="eyebrow" data-i18n="services.eyebrow">Services</div>
    <h1 class="page-title" data-i18n="services.title">Small studio.<br />Focused systems.</h1>
    <p class="lead" data-i18n="services.lead">Independent software work for problems that benefit from thoughtful architecture, automation and AI-native tooling.</p>
  </section>

  <section class="section">
    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={withBase(`/services/${service.id}/`)}>
          <img class="service-icon" src={withBase(serviceIcons[service.id])} alt="" loading="lazy" />
          <div>
            <div class="meta">0{service.data.order}</div>
            <h2>{service.data.title}</h2>
            <p>{service.data.summary}</p>
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
