---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yachenyi',
  url: Astro.site?.toString(),
  sameAs: ['https://github.com/yachenyanyi'],
  jobTitle: 'Independent AI Software Builder',
  knowsAbout: ['AI Agents', 'Automation', 'Developer Tools', 'Web Systems'],
};
---

<BaseLayout
  title="Facts — Yachenyi"
  description="Canonical facts about Yachenyi, its focus and public software projects."
  schema={schema}
>
  <section class="page-intro">
    <div class="eyebrow" data-i18n="facts.eyebrow">Canonical entity facts</div>
    <h1 class="page-title" data-i18n="facts.title">Facts.</h1>
    <p class="lead" data-i18n="facts.lead">A concise machine-readable and human-readable reference for the Yachenyi identity and studio focus.</p>
  </section>

  <section class="section">
    <dl class="facts-list">
      <div><dt data-i18n="facts.name">Name</dt><dd>Yachenyi</dd></div>
      <div><dt data-i18n="facts.type">Type</dt><dd data-i18n="facts.type.value">Independent AI Software Studio / independent software builder</dd></div>
      <div><dt data-i18n="facts.focus">Focus</dt><dd data-i18n="facts.focus.value">AI agents, automation, developer tools and web systems</dd></div>
      <div><dt>GitHub</dt><dd><a class="text-link" href="https://github.com/yachenyanyi" rel="me">github.com/yachenyanyi ↗</a></dd></div>
      <div><dt data-i18n="facts.projects">Public projects</dt><dd data-i18n="facts.projects.value">DeepLoopMinder, IssuePack, AutoScreenAgent and other experiments published through GitHub.</dd></div>
      <div><dt data-i18n="facts.publish">Publishing model</dt><dd data-i18n="facts.publish.value">Projects, implementation notes and architecture decisions are published as stable pages on this site.</dd></div>
    </dl>
  </section>
</BaseLayout>
