---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="Not found — Yachenyi"
  description="The requested page could not be found."
  noindex={true}
>
  <section class="page-intro">
    <div class="eyebrow" data-i18n="404.eyebrow">404 / Not found</div>
    <h1 class="page-title" data-i18n="404.title">Nothing here.<br />Keep building.</h1>
    <p class="lead" data-i18n="404.lead">The URL may have moved, or the page may not exist yet. The main project and lab indexes are the safest way back in.</p>
  </section>

  <section class="section contact-panel">
    <a class="button button-dark" href={withBase('/')} data-i18n="404.home">Back home</a>
    <a class="text-link" href={withBase('/projects/')} data-i18n="404.projects">Browse projects →</a>
  </section>
</BaseLayout>
