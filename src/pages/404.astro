---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="Not found — Yachenyi"
  description="The requested page could not be found."
  noindex={true}
>
  <section class="page-intro">
    <div class="eyebrow">404 / Not found</div>
    <h1 class="page-title">Nothing here.<br />Keep building.</h1>
    <p class="lead">The URL may have moved, or the page may not exist yet. The main project and lab indexes are the safest way back in.</p>
  </section>

  <section class="section contact-panel">
    <a class="button button-dark" href={withBase('/')}>Back home</a>
    <a class="text-link" href={withBase('/projects/')}>Browse projects →</a>
  </section>
</BaseLayout>
